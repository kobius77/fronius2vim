# GitHub Container Registry credentials for Watchtower
# Copy this file to .env and fill in your values

# Your GitHub username
GITHUB_USERNAME=your-github-username

# GitHub Personal Access Token with 'read:packages' scope
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Optional MQTT Broker Settings
# MQTT_HOST=172.20.204.22
# MQTT_PORT=1883
# MQTT_TOPIC=froniusalt/power
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_RETAIN=false
# MQTT_QOS=0

# Optional Zigbee (Zigbee2MQTT) subscription settings — enables the submetering dashboard
# ZIGBEE_MQTT_HOST=172.20.204.23
# ZIGBEE_MQTT_PORT=1883
# ZIGBEE_MQTT_USERNAME=mqtt2vim
# ZIGBEE_MQTT_PASSWORD=your-zigbee-mqtt-password
# ZIGBEE_MQTT_BASE=zigbee2mqtt
# ZIGBEE_ONLINE_GRACE=300
